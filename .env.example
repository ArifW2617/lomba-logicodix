# ====================================================================
# Cek Dulu — Multi-Provider AI Configuration
# ====================================================================

# 1. Primary AI Provider (Google Gemini - Multimodal Vision Only)
GEMINI_API_KEY=
GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-flash-lite

# 2. Text Fallback Provider (Groq API - Ultra-Low Latency Cascade)
# Sign up at: https://console.groq.com
GROQ_API_KEY=
GROQ_TEXT_MODEL=qwen/qwen3.8-27b
GROQ_MODELS=qwen/qwen3.8-27b,openai/gpt-oss-20b

# 3. Secondary Text Fallback Provider (OpenRouter - Fast Free Tier Cascade)
# Sign up at: https://openrouter.ai
OPENROUTER_API_KEY=
OPENROUTER_TEXT_MODEL=liquid/lfm-2.5-2.6b:free
OPENROUTER_MODELS=liquid/lfm-2.5-2.6b:free,nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3.5-lightning:free
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Cek Dulu

# 4. Provider Routing & Priority Order
AI_TEXT_PROVIDER_ORDER=groq,openrouter
AI_IMAGE_PROVIDER_ORDER=gemini

# 5. Reliability, Cooldown, and Timeout Parameters
AI_PROVIDER_TIMEOUT_MS=30000
AI_PROVIDER_MAX_RETRIES=1
AI_PROVIDER_COOLDOWN_DEFAULT_MS=60000

# 6. Hosting / App URL
APP_URL=http://localhost:3000
PORT=3000
